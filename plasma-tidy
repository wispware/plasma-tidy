def install_drawer():
    """Write the drawer widget where Plasma finds it. It ships inside this file, so that
    installing Tidy stays a matter of copying one file. A changed widget is picked up by
    Plasma at its next start."""
    for name, text in drawer_files().items():
        path = os.path.join(DRAWER_DIR, name)
        try:
            with open(path) as f:
                if f.read() == text:
                    continue
        except OSError:
            pass
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)


