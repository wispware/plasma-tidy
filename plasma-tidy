# The drawer widget (QML). It hides its neighbours in the panel; Tidy only installs it and
# writes its settings.
DRAWER_QML = r"""// SPDX-FileCopyrightText: 2026 Ivar
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Tidy Drawer: an arrow in the panel that tucks neighbouring widgets away.
// Generated by plasma-tidy; edit it there.
//
// Plasma has no public way to hide another widget, so this reaches into the panel's
// layout: every widget sits in an "applet container" next to ours. Nothing is written
// to those widgets (except the pinned list of a task manager in "pinned" mode); if a
// Plasma update changes the layout, the drawer simply stops hiding things.

import QtQuick
import QtQuick.Layouts
import org.kde.plasma.plasmoid
import org.kde.plasma.core as PlasmaCore
import org.kde.plasma.plasma5support as P5Support
import org.kde.kirigami as Kirigami
import org.kde.taskmanager as TaskManager

PlasmoidItem {
    id: root

    readonly property var cfg: Plasmoid.configuration
    readonly property bool vertical: Plasmoid.formFactor === PlasmaCore.Types.Vertical
    // While the panel is being edited everything must stay reachable.
    readonly property bool editing: (Plasmoid.containment?.corona?.editMode ?? false)
                                    || (Plasmoid.containment?.userConfiguring ?? false)
    // Removed from the panel (Plasma keeps a removed widget alive for a while, for "undo"):
    // let go of everything.
    property bool leaving: false
    Connections {
        target: Plasmoid
        function onDestroyedChanged(destroyed) {
            root.leaving = destroyed;
            root.syncPinned();
            root.syncFill();
        }
    }
    // Paused (Tidy's "Restore everything"): the drawer lets go of everything, as if it were
    // not there, until Tidy is switched on again or the arrow is clicked.
    readonly property bool wantClosed: cfg.closed && !editing && !leaving && !cfg.paused

    property Item container: null   // our own applet container
    property var siblings: []       // the other widgets: [{item, id, plugin, pos}]
    property int ownPos: -1

    function isTasks(plugin) {
        return plugin === "org.kde.plasma.icontasks" || plugin === "org.kde.plasma.taskmanager";
    }
    function inTargets(id) {
        return Array.from(cfg.targets).indexOf(id) >= 0;
    }

    // Widgets hidden as a whole, and task managers that only lose their pinned icons.
    readonly property var wholeTargets: siblings.filter(
        s => inTargets(s.id) && (!isTasks(s.plugin) || cfg.taskMode === "all"))
    readonly property var pinnedTargets: siblings.filter(
        s => inTargets(s.id) && isTasks(s.plugin) && cfg.taskMode === "pinned")
    function scan() {
        var c = root.parent, hops = 0;
        while (c && !c.isAppletContainer && hops < 8) { c = c.parent; hops++; }
        if (!c || !c.isAppletContainer || !c.parent) {
            container = null;
            siblings = [];
            return;
        }
        container = c;
        ownPos = c.index;
        var list = [], kids = c.parent.children;
        for (var i = 0; i < kids.length; i++) {
            var k = kids[i];
            if (!k || k === c || !k.isAppletContainer || !k.applet) continue;
            var applet = null;
            try { applet = k.applet.plasmoid; } catch (e) {}
            if (!applet) continue;
            list.push({item: k, id: String(applet.id), plugin: applet.pluginName, pos: k.index,
                       tray: trayStateOf(k.applet, applet.pluginName)});
        }
        // Only replace the list when it really changed: replacing it rebuilds the hiders.
        var key = l => l.map(s => s.id + "@" + s.pos + (s.tray ? "t" : "")).join(",");
        // The system tray builds its inside a little later: look again a few times.
        if (trayTries < 5 && list.some(s => s.plugin === "org.kde.plasma.systemtray" && !s.tray)) {
            trayTries++;
            trayRetry.restart();
        }
        if (key(list) !== key(siblings) || list.some((s, i) => s.item !== siblings[i].item))
            siblings = list;
        syncPinned();
        syncFill();
    }

    // Diagnostics: with the "debug" setting on "on", the state goes to the journal twice a second.
    function report() {
        console.warn("TIDYDRAWER " + JSON.stringify({
            own: ownPos, closed: cfg.closed, paused: cfg.paused, mode: cfg.taskMode,
            hover: panelHover !== null,
            width: Math.round(root.width), stretching: stretching, savedFill: cfg.savedFill,
            arrow_icon: arrowIcon, windows: hiddenWindows, attention: hiddenAttention,
            trays: siblings.filter(s => s.tray).length, popup_open: popupOpen,
            mark: markShown,
            inPanel: pointerInPanel, inDrawer: pointerInDrawer, arrow: arrowHovered,
            popup: popupOpen, saved: cfg.savedLaunchers, tap: panelTap !== null,
            memory: JSON.stringify(savedMemory),
            // is the middle of each widget's contents an empty spot, and the middle of the rest of it?
            spots: siblings.map(s => {
                var start = vertical ? s.item.y : s.item.x, full = vertical ? s.item.height : s.item.width;
                var extent = contentExtent(s.item);
                return s.plugin.replace("org.kde.plasma.", "") + ":" + isEmptySpot(start + extent / 2)
                    + (extent < full ? "/" + isEmptySpot(start + extent + (full - extent) / 2) : "");
            }),
            siblings: siblings.map(s => s.plugin.replace("org.kde.plasma.", "") + "#" + s.id + "@" + s.pos
                                        + (s.item.visible ? "" : "/hidden") + "/o" + s.item.opacity
                                        + "/w" + Math.round(s.item.width)
                                        + (isTasks(s.plugin) ? "/L" + Array.from(s.item.applet.plasmoid.configuration.launchers).length : "")),
            whole: wholeTargets.map(s => s.id), pinned: pinnedTargets.map(s => s.id)}));
    }
    Timer { interval: 500; repeat: true; running: root.cfg.debug === "on"; onTriggered: root.report() }

    Timer { id: rescan; interval: 300; onTriggered: root.scan() }
    Timer { id: trayRetry; interval: 2500; onTriggered: root.scan() }
    property int trayTries: 0
    // The system tray shows a pop-up of its own; whether it is open is kept in an object
    // inside it.
    function trayStateOf(item, plugin) {
        if (plugin !== "org.kde.plasma.systemtray" || !item) return null;
        var level = [item];
        for (var depth = 0; depth < 5 && level.length; depth++) {
            var next = [];
            for (var i = 0; i < level.length; i++) {
                var c = level[i];
                if (c && c.systemTrayState !== undefined && c.systemTrayState) return c.systemTrayState;
                if (c && c.children) for (var j = 0; j < c.children.length; j++) next.push(c.children[j]);
            }
            level = next;
        }
        return null;
    }
    onParentChanged: rescan.restart()
    Component.onCompleted: rescan.restart()
    Connections {
        target: root.container ? root.container.parent : null
        function onChildrenChanged() { rescan.restart(); }
    }
    Connections {
        target: root.container
        function onIndexChanged() { rescan.restart(); }
    }

    // --- hiding whole widgets ------------------------------------------------

    Instantiator {
        id: hiders
        model: root.wholeTargets
        delegate: QtObject {
            id: h
            required property var modelData
            readonly property Item item: modelData ? modelData.item : null
            readonly property bool after: modelData ? modelData.pos > root.ownPos : true
            // A widget that fills the panel (usually the task manager) keeps its place when
            // closed, so the rest of the panel doesn't jump; the others give up their space.
            readonly property bool fills: item ? (root.vertical ? item.wantsToFillHeight : item.wantsToFillWidth) : false
            property real size: 0   // natural size, remembered while open
            property real factor: root.wantClosed ? 0 : 1
            property bool ready: false
            readonly property real slide: Math.min(size, Kirigami.Units.gridUnit * 14) * (1 - factor)
            readonly property bool moving: factor > 0 && factor < 1

            function measure() {
                if (item && factor === 1) size = root.vertical ? item.height : item.width;
            }
            Component.onCompleted: { measure(); ready = true; }
            // A hider that goes while it is hiding (settings changed, drawer removed) must put
            // its widget back first: the bindings below only restore while they still exist.
            function release() { ready = false; factor = 1; }
            Component.onDestruction: release()
            onFactorChanged: measure()
            property Connections sizes: Connections {
                target: h.item
                function onWidthChanged() { h.measure(); }
                function onHeightChanged() { h.measure(); }
            }

            Behavior on factor {
                enabled: h.ready && root.cfg.animate && !root.leaving
                NumberAnimation { duration: Kirigami.Units.longDuration; easing.type: Easing.InOutCubic }
            }

            property Binding b1: Binding {
                target: h.item; property: "visible"; value: false
                when: h.factor === 0 && !h.fills
                restoreMode: Binding.RestoreBinding
            }
            property Binding b2: Binding {
                target: h.item; property: "opacity"; value: h.factor
                when: h.factor < 1
                restoreMode: Binding.RestoreBindingOrValue
            }
            property Binding b3: Binding {
                target: h.item; property: "enabled"; value: false
                when: h.factor < 1
                restoreMode: Binding.RestoreBindingOrValue
            }
            property Binding b4: Binding {
                target: h.item; property: "clip"; value: true
                when: h.factor < 1
                restoreMode: Binding.RestoreBindingOrValue
            }
            // The contents slide towards the arrow...
            property Binding b5: Binding {
                target: h.item && h.item.applet ? h.item.applet.anchors : null
                property: root.vertical ? (h.after ? "topMargin" : "bottomMargin")
                                        : (h.after ? "leftMargin" : "rightMargin")
                value: -h.slide
                when: h.moving && h.size > 0
                restoreMode: Binding.RestoreBindingOrValue
            }
            property Binding b6: Binding {
                target: h.item && h.item.applet ? h.item.applet.anchors : null
                property: root.vertical ? (h.after ? "bottomMargin" : "topMargin")
                                        : (h.after ? "rightMargin" : "leftMargin")
                value: h.fills ? h.slide : 0
                when: h.moving && h.size > 0
                restoreMode: Binding.RestoreBindingOrValue
            }
            // ...while a widget that gives up its space shrinks.
            readonly property bool shrinking: h.moving && !h.fills && h.size > 0
            property Binding b7: Binding {
                target: h.item ? h.item.Layout : null
                property: root.vertical ? "maximumHeight" : "maximumWidth"
                value: h.size * h.factor
                when: h.shrinking
                restoreMode: Binding.RestoreBinding
            }
            property Binding b8: Binding {
                target: h.item ? h.item.Layout : null
                property: root.vertical ? "preferredHeight" : "preferredWidth"
                value: h.size * h.factor
                when: h.shrinking
                restoreMode: Binding.RestoreBinding
            }
            property Binding b9: Binding {
                target: h.item ? h.item.Layout : null
                property: root.vertical ? "minimumHeight" : "minimumWidth"
                value: 0
                when: h.shrinking
                restoreMode: Binding.RestoreBinding
            }

            // A hidden program asks for attention: open up.
            property Connections attention: Connections {
                target: h.item && h.item.applet ? h.item.applet.plasmoid : null
                function onStatusChanged() {
