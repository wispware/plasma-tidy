                         "choose \"Where I put it myself\", right-click the panel, choose "
                         "Enter Edit Mode and drag it."))
        hint.setWordWrap(True)
        hint.setEnabled(False)
        form.addRow(hint)
        parts.addTab(page, tr("Arrow"))

