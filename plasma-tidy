        footer.addWidget(self.button_box)
        outer.addLayout(footer)

        self.mode.currentIndexChanged.connect(self.update_enabled)
        self.update_enabled()

        self.ticker = QTimer(self, interval=100)
        self.ticker.timeout.connect(self.update_status)
        self.ticker.start()
        self.update_status()

    def on_support(self, _link):
        # Met doneerpagina: direct daarheen. Anders naar het tabblad Over.
        if DONATE_URL:
            open_donate()
        else:
            self.tabs.setCurrentWidget(self.about_tab)

    def update_enabled(self):
        click = self.mode.currentData() == MODE_CLICK
        for box in self.buttons.values():
            box.setEnabled(click)
        self.rehide.setEnabled(click)
        # In klikmodus moet er minstens één knop gekozen zijn.
        self.button_box.button(QDialogButtonBox.StandardButton.Ok).setEnabled(
            not click or any(b.isChecked() for b in self.buttons.values()))

    def update_status(self):
        a = self.autohide
        remaining = a.remaining()
        total = a.settings.value("timeout", 10, int)
        if not a.enabled_action.isChecked():
            self.status_label.setText("Uitgeschakeld")
            self.bar.setValue(0)
            self.bar.setFormat("—")
        elif a.hidden:
            wait = "een klik op het bureaublad" if a.mode() == MODE_CLICK else "een muisbeweging of toets"
            self.status_label.setText(f"Verborgen — wacht op {wait}")
            self.bar.setValue(0)
            self.bar.setFormat("0 s")
        elif a.busy():
            self.status_label.setText("Gepauzeerd — menu open of Plasma in bewerkingsmodus")
            self.bar.setValue(1000)
            self.bar.setFormat("pauze")
        else:
            self.status_label.setText("Zichtbaar — verbergen over:")
            self.bar.setValue(int(1000 * remaining / total))
            self.bar.setFormat(f"{remaining:.0f} s")

    def chosen_buttons(self):
        return ",".join(k for k, b in self.buttons.items() if b.isChecked())


class Tidy(QObject):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.settings = QSettings(APP, APP)
        self.plasma = Plasma()
        self.kwin = KWin()
        self.hidden = False
        self.idle = None
        self.idle_since = None      # moment waarop de huidige stilte begon
        self.desktop_active = True  # is het bureaublad het actieve venster?
        self.popup_open = False     # staat er ergens een menu/pop-up open?
        self.plasma_shell = QDBusInterface("org.kde.plasmashell", "/PlasmaShell",
                                           "org.kde.PlasmaShell", QDBusConnection.sessionBus())
        self.shown_at = time.monotonic()
        self.catchers = []
        self.dialog = None
        os.makedirs(EMPTY_DIR, exist_ok=True)

        self.recover_after_crash()
        self.showing_desktop = self.kwin.showing_desktop()
        bus = QDBusConnection.sessionBus()
        bus.connect("org.kde.KWin", "/KWin", "org.kde.KWin",
                    "showingDesktopChanged", self.on_showing_desktop)

        # Plasma herstart: daarna opnieuw nakijken of alles klopt.
        self.plasma_watcher = QDBusServiceWatcher(
            "org.kde.plasmashell", bus, QDBusServiceWatcher.WatchModeFlag.WatchForRegistration)
        self.plasma_watcher.serviceRegistered.connect(
            lambda _: QTimer.singleShot(3000, self.on_plasma_restarted))

        # Scherm aangesloten/losgekoppeld: klikvensters opnieuw opbouwen.
        app.screenAdded.connect(self.on_screens_changed)
        app.screenRemoved.connect(self.on_screens_changed)

        self.tray = QSystemTrayIcon()
        menu = QMenu()
        self.enabled_action = QAction("Ingeschakeld", menu, checkable=True)
        self.enabled_action.setChecked(self.settings.value("enabled", True, bool))
        self.enabled_action.toggled.connect(self.set_enabled)
        menu.addAction(self.enabled_action)
        menu.addAction(QIcon.fromTheme("configure"), "Instellingen…", self.show_settings)
        menu.addAction(QIcon.fromTheme("help-about"), f"Over {APP_NAME}",
                       lambda: self.show_settings(about=True))
        menu.addAction("♥ Doneren…", self.on_donate)
        menu.addSeparator()
        menu.addAction("Afsluiten", self.quit)
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self.on_tray_click)
        self.update_icon()
        self.tray.show()

        self.tick = QTimer(self, interval=250)
        self.tick.timeout.connect(self.on_tick)
        self.tick.start()

        if self.enabled_action.isChecked():
            self.start_idle()

    def mode(self):
        return self.settings.value("mode", MODE_ACTIVITY)

    def fixed_rehide(self):
        return self.mode() == MODE_CLICK and self.settings.value("rehide", REHIDE_IDLE) == REHIDE_FIXED

    def counts_activity(self):
        """Telt muis/toetsenbord nu mee? Niet als je in een ander venster werkt."""
        return self.desktop_active or not self.settings.value("only_desktop", True, bool)

    def on_desktop_active(self, active):
        was = self.desktop_active
        self.desktop_active = active
        if active and not was:
            # Naar het bureaublad gaan is zelf activiteit.
            self.idle_since = None
            if self.hidden and self.mode() == MODE_ACTIVITY:
                self.show()
        elif not active and was and self.idle_since is None:
            # Weg van het bureaublad: vanaf nu telt de teller door.
            self.idle_since = time.monotonic()

    def remaining(self):
        """Seconden tot het verbergen (alleen zinvol als ze zichtbaar zijn)."""
        timeout = self.settings.value("timeout", 10, int)
        now = time.monotonic()
        if self.fixed_rehide():
            left = timeout - (now - self.shown_at)
        elif self.idle_since is None:
            left = timeout
        else:
            left = timeout - (now - self.idle_since)
        return max(0.0, left)

    def busy(self):
        """Niet verbergen terwijl je Plasma aan het bewerken bent of een menu open hebt:
        verbergen herlaadt het bureaublad en dat sluit de bewerkingsmodus en menu's."""
        return self.popup_open or bool(self.plasma_shell.property("editMode"))

    def on_tick(self):
        if self.enabled_action.isChecked() and not self.hidden and self.remaining() <= 0:
            if self.busy():
                # Uitstellen: de teller begint opnieuw zodra je klaar bent.
                self.shown_at = time.monotonic()
                self.idle_since = time.monotonic()
                return
            self.hide()

    # --- verbergen / tonen ------------------------------------------------

    def hide(self):
        if self.hidden:
            return
        urls = {k: v for k, v in self.plasma.desktop_urls().items() if v != EMPTY_URL}
        if not urls:
            return  # plasmashell niet bereikbaar (bijv. net aan het herstarten)
        state = {"urls": urls}
        if self.settings.value("hide_panel", False, bool):
            modes = self.plasma.panel_modes()
            state["panels"] = modes
            self.plasma.set_panel_modes({k: "autohide" for k in modes})
        # Eerst opslaan, dan pas verbergen: zo kan een crash nooit iets kwijtraken.
        self.settings.setValue("saved_state", json.dumps(state))
        self.settings.sync()
        self.plasma.set_desktop_urls({k: EMPTY_URL for k in urls})
        self.hidden = True
        self.update_icon()
        if self.mode() == MODE_CLICK:
            self.show_catchers()

    def show(self):
        self.hide_catchers()
        raw = self.settings.value("saved_state", "")
        if raw:
            state = json.loads(raw)
            self.plasma.set_desktop_urls({int(k): v for k, v in state.get("urls", {}).items()})
            if "panels" in state:
                self.plasma.set_panel_modes({int(k): v for k, v in state["panels"].items()})
            self.settings.remove("saved_state")
            self.settings.sync()
        self.hidden = False
        self.shown_at = time.monotonic()
        self.idle_since = None if self.counts_activity() else time.monotonic()
        if hasattr(self, "tray"):
            self.update_icon()

    def recover_after_crash(self):
        """Stond het bureaublad nog op de lege map (crash, uitloggen)? Zet het terug."""
        if self.settings.value("saved_state", ""):
            self.show()
        stuck = {k: "desktop:/" for k, v in self.plasma.desktop_urls().items() if v == EMPTY_URL}
        if stuck:
            self.plasma.set_desktop_urls(stuck)

    def on_plasma_restarted(self):
        if not self.hidden:
            self.recover_after_crash()

    # --- klikvensters -----------------------------------------------------

    def show_catchers(self):
        self.hide_catchers()
        for screen in self.app.screens():
            catcher = Catcher(screen, self.on_catcher_click)
            catcher.show()
            self.catchers.append(catcher)

    def hide_catchers(self):
        for catcher in self.catchers:
            catcher.close()
            catcher.deleteLater()
        self.catchers = []

    def on_screens_changed(self, _screen):
        if self.catchers:
            self.show_catchers()

    def on_catcher_click(self, button):
        chosen = self.settings.value("buttons", "left,right,middle").split(",")
        if any(BUTTONS[k] == button for k in chosen if k in BUTTONS):
            self.show()

    @pyqtSlot(bool)
    def on_showing_desktop(self, showing):
        self.showing_desktop = showing
        if showing and self.hidden:
            self.show()

    # --- inactiviteit -----------------------------------------------------

    def start_idle(self):
        self.stop_idle()
        self.idle_since = None
        self.idle = QProcess()
        self.idle.readyReadStandardOutput.connect(self.on_idle_output)
        self.idle.finished.connect(self.on_idle_died)
        self.idle.start("swayidle", ["-w", "timeout", str(IDLE_STEP), "echo idle",
                                     "resume", "echo active"])

    def stop_idle(self):
        if self.idle:
            self.idle.readyReadStandardOutput.disconnect()
            self.idle.finished.disconnect()
            self.idle.kill()
            self.idle.waitForFinished(1000)
            self.idle = None

    def on_idle_died(self):
        # swayidle onverwacht gestopt: na even wachten opnieuw starten.
        self.idle = None
        if self.enabled_action.isChecked():
            QTimer.singleShot(2000, self.start_idle)

    def on_idle_output(self):
        for line in bytes(self.idle.readAllStandardOutput()).decode().split():
            if line == "idle":
                since = time.monotonic() - IDLE_STEP
                if self.idle_since is None or self.counts_activity():
                    self.idle_since = since
            elif line == "active":
                if not self.counts_activity():
                    continue
                self.idle_since = None
                if self.hidden and (self.mode() == MODE_ACTIVITY or self.showing_desktop):
                    self.show()

    # --- tray -------------------------------------------------------------

    def update_icon(self):
        if not self.enabled_action.isChecked():
            pixmap = QIcon.fromTheme("view-visible").pixmap(64, QIcon.Mode.Disabled)
            self.tray.setIcon(QIcon(pixmap))
            status = "uitgeschakeld"
        elif self.hidden:
            self.tray.setIcon(QIcon.fromTheme("view-hidden"))
            status = "pictogrammen verborgen"
        else:
            self.tray.setIcon(QIcon.fromTheme("view-visible"))
            status = "pictogrammen zichtbaar"
        self.tray.setToolTip(f"{APP_NAME} — {status}")

    def set_enabled(self, on):
        self.settings.setValue("enabled", on)
        self.update_icon()
        if on:
            self.shown_at = time.monotonic()
            self.start_idle()
        else:
            self.stop_idle()
            self.show()

    def on_tray_click(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.show_settings()

    def on_donate(self):
        if DONATE_URL:
            open_donate()
        else:
            self.show_settings(about=True)

    def show_settings(self, about=False):
        if self.dialog:
            if about:
                self.dialog.tabs.setCurrentWidget(self.dialog.about_tab)
            self.dialog.raise_()
            self.dialog.activateWindow()
            return
        # Niet-modaal: een modaal venster zou de klikken op onze eigen
        # klikvensters blokkeren, en dus het testen van de klikmodus.
        self.dialog = SettingsDialog(self)
        self.dialog.accepted.connect(lambda dlg=self.dialog: self.apply_settings(dlg))
        self.dialog.finished.connect(self.on_dialog_closed)
        if about:
            self.dialog.tabs.setCurrentWidget(self.dialog.about_tab)
        self.dialog.show()

    def on_dialog_closed(self):
        self.dialog.deleteLater()
        self.dialog = None

    def apply_settings(self, dlg):
        self.show()  # nieuwe instellingen gaan in vanaf nu
        old_corner = self.settings.value("corner", "none")
        self.settings.setValue("timeout", dlg.timeout.value())
        self.settings.setValue("mode", dlg.mode.currentData())
        self.settings.setValue("buttons", dlg.chosen_buttons())
        self.settings.setValue("rehide", dlg.rehide.currentData())
        self.settings.setValue("corner", dlg.corner.currentData())
        self.settings.setValue("hide_panel", dlg.panel.isChecked())
        self.settings.setValue("only_desktop", dlg.only_desktop.isChecked())
        self.set_autostart(dlg.autostart.isChecked())
        dlg.tray_tab.apply()
        if dlg.corner.currentData() != old_corner:
            self.kwin.load(dlg.corner.currentData())

    def set_autostart(self, on):
        if on:
            os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
            with open(AUTOSTART, "w") as f:
                f.write(f"[Desktop Entry]\nType=Application\nName={APP_NAME}\n"
                        f"Exec={os.path.abspath(sys.argv[0])}\nIcon=view-visible\n"
                        "X-KDE-autostart-after=panel\n")
        elif os.path.exists(AUTOSTART):
            os.remove(AUTOSTART)

    def quit(self):
        if self.dialog:
            self.dialog.reject()
        self.stop_idle()
        self.show()
        self.kwin.unload()
        self.app.quit()


def migrate_old_config():
    """Eenmalig: instellingen van de oude naam (AutoHide Desktop Icons) overnemen."""
    old = os.path.expanduser(f"~/.config/{OLD_APP}/{OLD_APP}.conf")
    new = os.path.expanduser(f"~/.config/{APP}/{APP}.conf")
    if os.path.exists(old) and not os.path.exists(new):
        os.makedirs(os.path.dirname(new), exist_ok=True)
        shutil.copy2(old, new)


COMMANDS = {"--show": "Show", "--hide": "Hide", "--toggle": "Toggle", "--settings": "Settings"}
USAGE = "Gebruik: plasma-tidy [--show | --hide | --toggle | --settings | --version]"


def main():
    command = None
    for arg in sys.argv[1:]:
        if arg == "--version":
            print(f"{APP_NAME} (plasma-tidy) {VERSION}")
            return 0
        if arg in COMMANDS:
            command = COMMANDS[arg]
        else:
            print(USAGE, file=sys.stderr)
            return 2

    migrate_old_config()
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setDesktopFileName(APP)
    app.setQuitOnLastWindowClosed(False)

    bus = QDBusConnection.sessionBus()
    if not bus.registerService(DBUS_NAME):
        # Er draait al een kopie: geef de opdracht door (standaard: instellingen openen).
        QDBusInterface(DBUS_NAME, "/", DBUS_NAME, bus).call(command or "Settings")
        return 0

    if not shutil.which("swayidle"):
        QMessageBox.critical(None, APP_NAME,
                             "swayidle ontbreekt.\n\nInstalleer het met:\nsudo dnf install swayidle")
        return 1

    autohide = Tidy(app)
    adaptor = DBusAdaptor(autohide)
    bus.registerObject("/", autohide)
    # Pas nu laden: het KWin-script meldt meteen het actieve venster via D-Bus.
    autohide.kwin.load(autohide.settings.value("corner", "none"))
    if command in ("Show", "Hide", "Settings"):
        QTimer.singleShot(0, getattr(adaptor, command))

    # Netjes terugzetten bij uitloggen/afsluiten (SIGTERM) of Ctrl+C.
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: autohide.quit())
    tick = QTimer()  # laat Python signalen verwerken terwijl Qt draait
    tick.start(500)
    tick.timeout.connect(lambda: None)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
