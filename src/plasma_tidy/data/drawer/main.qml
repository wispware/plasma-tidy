                    root.cfg.closed = true;
            }
            TaskManager.VirtualDesktopInfo { id: watchDesktop }
            TaskManager.ActivityInfo { id: watchActivity }
            TaskManager.TasksModel {
                id: windows
                virtualDesktop: watchDesktop.currentDesktop
                activity: watchActivity.currentActivity
                filterByVirtualDesktop: true
                filterByActivity: true
                groupMode: TaskManager.TasksModel.GroupDisabled
                onActiveTaskChanged: check.restart()
                onDataChanged: check.restart()
            }
            Timer { id: check; interval: 150; onTriggered: watch.evaluate() }
            Component.onCompleted: check.restart()
        }
    }

    // --- opening and closing ---------------------------------------------------

    function toggle() { cfg.closed = !cfg.closed; }
    // The widget's own keyboard shortcut (set in Tidy, or in Plasma's settings of the widget).
    activationTogglesExpanded: false
    Connections {
        target: Plasmoid
        function onActivated() {
            if (root.cfg.paused) root.cfg.paused = false;
            else root.toggle();
        }
    }

    // Where is the pointer? Over the panel is watched on the panel's layout; over the
    // drawer itself means over the arrow or over one of its widgets.
    Component { id: hoverComponent; HoverHandler {} }
    property var panelHover: null
    onContainerChanged: {
        // The old one may be gone already, together with the panel it was watching.
        try { if (panelHover) panelHover.destroy(); } catch (e) {}
        try { if (panelTap) panelTap.destroy(); } catch (e) {}
        panelHover = null;
        panelTap = null;
        if (container && container.parent) {
            panelHover = hoverComponent.createObject(container.parent);
            panelTap = tapComponent.createObject(container.parent);
        }
    }

    // A click on an empty spot of the panel closes the drawer. The panel passes every
    // click to this handler as well, also those on a widget, so "empty" is worked out
    // from the layout: no widget there, or only the unused part of one that fills the panel.
    Component {
        id: tapComponent
        TapHandler {
            acceptedButtons: Qt.LeftButton
            onTapped: (eventPoint, button) => root.panelTapped(
                root.vertical ? eventPoint.position.y : eventPoint.position.x)
        }
    }
    property var panelTap: null
    // Every drawer in the panel hears the same click. Together they do one thing: if a
    // drawer that closes on such a click is open, the click closes; only when none is, it
    // opens the drawers that are set to open that way. Each drawer decides from how things
    // are at the moment of the click and acts a moment later, so that one drawer closing
    // does not make the next one think nothing was open.
    function closesOnClick(conf) {
        return !conf.closed && !conf.paused && conf.closeOnPanelClick;
    }
    function anyClosesOnClick() {
        if (closesOnClick(cfg)) return true;
        for (var i = 0; i < siblings.length; i++) {
            if (siblings[i].plugin !== Plasmoid.pluginName) continue;
            try {
                if (closesOnClick(siblings[i].item.applet.plasmoid.configuration)) return true;
            } catch (e) {}
        }
        return false;
    }
    function panelTapped(pos) {
        if (cfg.paused) return;
        if (cfg.closed) {
            if (cfg.openOnPanelClick && isEmptySpot(pos) && !anyClosesOnClick())
                Qt.callLater(() => { root.cfg.closed = false; });
            return;
        }
        if (cfg.closeOnPanelClick && isEmptySpot(pos))
            Qt.callLater(() => { root.cfg.closed = true; });
        else if (cfg.closeAfterUse && inDrawerItem(pos))
            useTimer.restart();
    }
    // A click on something in the drawer: close once it has done its work. A pop-up that the
    // click opened (system tray) is waited for.
    function inDrawerItem(pos) {
        var mirrored = !vertical && Qt.application.layoutDirection === Qt.RightToLeft;
        return drawerItems.some(s => {
            var k = s.item;
            if (!k || !k.applet || !k.visible || k.opacity === 0) return false;
            var start = vertical ? k.y : k.x, full = vertical ? k.height : k.width;
            var extent = contentExtent(k);
            var from = mirrored ? start + full - extent : start;
            return pos >= from && pos <= from + extent;
        });
    }
    property bool closeAfterPopup: false
    Timer {
        id: useTimer
        interval: 400
        onTriggered: {
            if (root.popupOpen) root.closeAfterPopup = true;
            else if (!root.cfg.paused) root.cfg.closed = true;
        }
    }
    onPopupOpenChanged: {
        if (!popupOpen && closeAfterPopup) {
            closeAfterPopup = false;
            if (!cfg.paused) cfg.closed = true;
        }
    }
    function contentExtent(k) {
        var full = vertical ? k.height : k.width;
        var wanted = vertical ? k.applet.Layout.preferredHeight : k.applet.Layout.preferredWidth;
        return (wanted > 0 && wanted < full) ? wanted : full;
    }
    function isEmptySpot(pos) {
        if (!container || !container.parent) return false;
        var kids = container.parent.children;
        var mirrored = !vertical && Qt.application.layoutDirection === Qt.RightToLeft;
        for (var i = 0; i < kids.length; i++) {
            var k = kids[i];
            // Hidden by a drawer but still holding its place: that looks empty too.
            if (!k || !k.isAppletContainer || !k.applet || !k.visible || k.opacity === 0) continue;
            var plugin = "";
            try { plugin = k.applet.plasmoid.pluginName; } catch (e) {}
            if (plugin === "org.kde.plasma.panelspacer" || plugin === "org.kde.plasma.marginsseparator")
                continue;
            var start = vertical ? k.y : k.x, full = vertical ? k.height : k.width;
            var extent = contentExtent(k);
            var from = mirrored ? start + full - extent : start;
            if (pos >= from && pos <= from + extent) return false;
        }
        return true;
    }
    readonly property bool pointerInPanel: (panelHover ? panelHover.hovered : false) || arrowHovered

    readonly property var drawerItems: siblings.filter(s => inTargets(s.id))
    property bool itemsHovered: false
    function updateItemsHovered() {
        var any = false;
        for (var i = 0; i < watchers.count; i++) {
            var w = watchers.objectAt(i);
            if (w && w.inside) { any = true; break; }
        }
        itemsHovered = any;
    }
    Instantiator {
        id: watchers
        model: root.drawerItems
        onObjectAdded: root.updateItemsHovered()
        onObjectRemoved: root.updateItemsHovered()
        delegate: QtObject {
            id: watcher
            required property var modelData
            readonly property Item item: modelData ? modelData.item : null
            property var handler: null
            // A widget that fills the panel is mostly empty space: only the part that holds
            // its contents counts as the drawer.
            readonly property real extent: {
                if (!item || !item.applet) return 0;
                var full = root.vertical ? item.height : item.width;
                var wanted = root.vertical ? item.applet.Layout.preferredHeight
                                           : item.applet.Layout.preferredWidth;
                return (wanted > 0 && wanted < full) ? wanted : full;
            }
            readonly property bool inside: {
                if (!handler || !handler.hovered || !item) return false;
                var pos = root.vertical ? handler.point.position.y : handler.point.position.x;
                var full = root.vertical ? item.height : item.width;
                var mirrored = !root.vertical && Qt.application.layoutDirection === Qt.RightToLeft;
                return mirrored ? pos >= full - extent : pos <= extent;
            }
            onInsideChanged: root.updateItemsHovered()
            Component.onCompleted: if (item) handler = hoverComponent.createObject(item)
            Component.onDestruction: { try { if (handler) handler.destroy(); } catch (e) {} }
        }
    }
    readonly property bool pointerInDrawer: arrowHovered || itemsHovered || popupHovered
    readonly property bool pointerHere: cfg.closeScope === "panel" ? (pointerInPanel || popupHovered)
                                                                   : pointerInDrawer
    function hasPopupOpen(applet) {
        // Widgets shown in full in the panel (task manager, pager, ...) always count as
        // "expanded"; only a widget with an icon in the panel has a real pop-up.
        return applet && applet.expanded && applet.compactRepresentationItem !== null
            && applet.compactRepresentationItem.visible;
    }
    // A pop-up of one of the widgets (menu, calendar, ...) counts as "still busy here".
    readonly property bool popupOpen: siblings.some(
        s => hasPopupOpen(s.item.applet) || (s.tray !== null && s.tray.expanded))

    Timer {
        id: closeTimer
        interval: root.cfg.autoClose ? Math.max(0, root.cfg.closeDelay) : 700
        // A pop-up closes when the pointer leaves it, whether or not "close by itself" is set:
        // it lies over your windows.
        running: (root.cfg.autoClose || (root.popupMode && root.popupVisited))
                 && !root.cfg.closed && !root.cfg.paused && !root.editing
                 && !root.pointerHere && !root.popupOpen
                 && (root.cfg.closeScope !== "panel" || root.panelHover !== null)
        onTriggered: root.cfg.closed = true
    }
    Timer {
        id: hoverTimer
        interval: Math.max(0, root.cfg.hoverDelay)
        onTriggered: if (root.arrowHovered) root.cfg.closed = false
    }

    P5Support.DataSource {
        id: runner
        engine: "executable"
        onNewData: (source, data) => disconnectSource(source)
    }
    Plasmoid.contextualActions: [
        PlasmaCore.Action {
            text: root.cfg.textSettings
            icon.name: "configure"
            visible: root.cfg.tidyCommand !== ""
            onTriggered: runner.connectSource(root.cfg.tidyCommand + " --settings")
        }
    ]

    // --- the arrow -------------------------------------------------------------

    preferredRepresentation: fullRepresentation
    Plasmoid.backgroundHints: PlasmaCore.Types.NoBackground

    readonly property int thickness: Kirigami.Units.iconSizes.small + Kirigami.Units.smallSpacing
    Layout.fillWidth: !vertical && stretching
    Layout.fillHeight: vertical && stretching
    Layout.minimumWidth: vertical ? -1 : thickness
    Layout.preferredWidth: vertical ? -1 : thickness
    Layout.maximumWidth: vertical ? -1 : (stretching ? Infinity : thickness)
    Layout.minimumHeight: vertical ? thickness : -1
    Layout.preferredHeight: vertical ? thickness : -1
    Layout.maximumHeight: vertical ? (stretching ? Infinity : thickness) : -1

    // Closed, the arrow points the way the drawer opens: away from the nearest end of the
    // panel. Open, it points back.
    readonly property bool inFirstHalf: {
        if (!container || !container.parent) return true;
        var at = (vertical ? container.y : container.x) + thickness / 2;
        return at < (vertical ? container.parent.height : container.parent.width) / 2;
    }
    // As a pop-up it points to where the pop-up comes: away from the screen edge.
    readonly property bool popupAhead: Plasmoid.location === PlasmaCore.Types.TopEdge
                                       || Plasmoid.location === PlasmaCore.Types.LeftEdge
    readonly property bool pointsForward: popupMode ? ((cfg.closed === popupAhead) !== cfg.reverseArrow)
                                                    : ((cfg.closed === inFirstHalf) !== cfg.reverseArrow)
    readonly property bool arrowUpDown: popupMode ? !vertical : vertical
    readonly property string arrowIcon: {
        var f = pointsForward, vertical = arrowUpDown;
        switch (cfg.icon) {
        case "double":
            return vertical ? (f ? "arrow-down-double" : "arrow-up-double")
                            : (f ? "arrow-right-double" : "arrow-left-double");
        case "triangle":
            return vertical ? (f ? "pan-down-symbolic" : "pan-up-symbolic")
                            : (f ? "pan-end-symbolic" : "pan-start-symbolic");
        case "dots": return root.vertical ? "view-more-symbolic" : "view-more-horizontal-symbolic";
        case "menu": return "application-menu";
        case "handle": return "drag-handle-symbolic";
        case "custom": return cfg.iconCustom;
        case "none": return "";
        }
        return vertical ? (f ? "arrow-down" : "arrow-up") : (f ? "arrow-right" : "arrow-left");
    }

    property bool arrowHovered: false

    fullRepresentation: Item {
        // The arrow sits at the start of the widget; when the widget fills the panel, the
        // rest of it is empty panel space.
        PlasmaCore.ToolTipArea {
            active: root.cfg.arrowTip
            width: root.vertical ? parent.width : root.thickness
            height: root.vertical ? root.thickness : parent.height
            // Standing after the icons, the arrow slides along with them.
            readonly property real travel: root.slideActive ? -root.knobTravel * (1 - root.slideP) : 0
            x: root.vertical ? 0 : travel
            y: root.vertical ? travel : 0
            readonly property string action: root.cfg.paused ? root.cfg.textPaused
                : (root.cfg.closed ? root.cfg.textOpen : root.cfg.textClose)
            // With a name: the name, and below it what a click does.
            mainText: root.cfg.name !== "" ? root.cfg.name : action
            subText: root.cfg.name !== "" ? action : ""

            Kirigami.Icon {
                anchors.centerIn: parent
                width: Kirigami.Units.iconSizes.small
                height: width
                id: arrow
                source: root.arrowIcon
                visible: root.cfg.icon !== "none"
                active: root.arrowHovered
                opacity: root.cfg.paused ? 0.4 : 1
            }
            // Without an icon the spot only shows itself under the pointer.
            Rectangle {
                anchors.fill: parent
                anchors.margins: Math.round(Kirigami.Units.smallSpacing / 2)
                visible: root.cfg.icon === "none" && root.arrowHovered
                radius: Kirigami.Units.smallSpacing
                color: Kirigami.Theme.textColor
                opacity: 0.15
            }
            // The mark: a dot, or the number of open programs.
            Rectangle {
                id: mark
                readonly property bool counting: root.cfg.indicator === "count" && root.hiddenWindows > 0
                visible: root.markShown
                anchors.horizontalCenter: arrow.right
                anchors.horizontalCenterOffset: -Math.round(arrow.width * 0.15)
                anchors.verticalCenter: arrow.top
                anchors.verticalCenterOffset: Math.round(arrow.height * 0.1)
                height: Math.round(arrow.height * (counting ? 0.7 : 0.4))
                width: counting ? Math.max(height, number.implicitWidth + Math.round(height * 0.5)) : height
                radius: height / 2
                color: root.hiddenAttention ? Kirigami.Theme.neutralTextColor : Kirigami.Theme.highlightColor
                Text {
                    id: number
                    visible: mark.counting
                    anchors.centerIn: parent
                    text: root.hiddenWindows
                    color: Kirigami.Theme.highlightedTextColor
                    font.pixelSize: Math.round(mark.height * 0.8)
                    font.bold: true
                }
            }
            MouseArea {
                anchors.fill: parent
                hoverEnabled: true
                acceptedButtons: Qt.LeftButton
                onContainsMouseChanged: root.arrowHovered = containsMouse
                onClicked: {
                    hoverTimer.stop();
                    if (root.cfg.paused) root.cfg.paused = false;
                    else root.toggle();
                }
                onEntered: if (root.cfg.openOn === "hover" && root.cfg.closed && !root.cfg.paused)
                               hoverTimer.restart()
                onExited: hoverTimer.stop()
            }
        }
    }
}
